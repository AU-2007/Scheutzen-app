# Name des Vereins (erscheint oben in der App)
VEREIN_NAME=Schützenverein Musterdorf

# Langer Zufallswert! Erzeugen mit:  openssl rand -hex 32
SECRET_KEY=bitte-aendern

# Erster Admin – wird nur beim allerersten Start angelegt.
# Passwort muss nach dem ersten Login geändert werden.
ADMIN_USER=admin
# Mindestens 8 Zeichen. Leer lassen = die App erzeugt ein Zufallspasswort
# und schreibt es einmalig ins Log (docker compose logs).
ADMIN_PASSWORD=

# Auf 1 setzen, sobald die App nur noch über HTTPS erreichbar ist
COOKIE_SECURE=0

# Auf 1 setzen, wenn die App hinter einem Reverse Proxy oder Cloudflare Tunnel läuft
# (dann stimmen IP-Adressen im Login-Protokoll und die HTTPS-Erkennung)
TRUST_PROXY=0

# Auf welcher IP der Port 8000 lauscht. 127.0.0.1 = nur vom selben Rechner (Proxy/Tunnel im selben LXC).
# Läuft der Reverse Proxy auf einem anderen Rechner: hier die IP dieses Servers eintragen
# und den Port in der Firewall nur für den Proxy freigeben.
BIND_IP=127.0.0.1

# ---- Nur für den Betrieb auf einem Cloud-VPS mit eingebautem HTTPS (Caddy) ----
# Domain, die per DNS-A-Eintrag auf die IP des VPS zeigt:
# DOMAIN=mannschaft.meinverein.de
# Caddy zusätzlich starten (dann reicht überall "docker compose ..."):
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml

# ---- Sicherungen (werden nur von den Skripten auf dem Server gelesen) ----
# Ordner für Sicherungen, am besten ein eigenes Laufwerk (z. B. ein zusätzliches Volume des VPS):
# BACKUP_DIR=/mnt/backup
# Wie viele Sicherungen bleiben:
# BACKUP_KEEP_TAGE=14      tägliche Sicherungen (Tage)
# BACKUP_KEEP_NEUBAU=3     Sicherungen vor jedem Neubau/Update/Zurückrollen
# BACKUP_KEEP_MANUELL=5    von Hand angestoßene Sicherungen
